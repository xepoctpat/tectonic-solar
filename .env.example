# Server-side only. Do not commit this file. Do not put a key in public/ or browser JS.
# The AI Briefing tab works without this (local snapshot writer).
# If you want Grok prose on a private host, set the key here and restart npm start.
XAI_API_KEY=

# Optional model override. Default is grok-4.5.
# XAI_MODEL=grok-4.5
