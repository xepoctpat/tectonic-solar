    "name": "Peter Bird PB2002 Table 1 - plate identifiers, areas, and Euler poles",
    "citation": "Bird, P. (2003). An updated digital model of plate boundaries. Geochemistry Geophysics Geosystems, 4(3), 1027. doi:10.1029/2001GC000252",
    "sourceUrl": "http://peterbird.name/publications/2003_PB2002/2001GC000252.pdf",
    "sourceLocation": "Table 1, page 6 of the published PDF",
    "transcription": "Values transcribed programmatically from the published PDF text layer (pdftotext -raw). The PDF minus sign is an unmapped glyph; it was read as U+FFFD and interpreted as negative.",
    "referenceFrame": "All poles are expressed in the Pacific-plate reference frame. Rotation about each pole is counterclockwise when seen from outside the Earth.",
    "columns": {
      "code": "Two-letter plate identifier",
      "name": "Plate name",
      "areaSteradian": "Plate area in steradians",
      "latDeg": "Euler pole latitude, degrees north",
      "lonDeg": "Euler pole longitude, degrees east",
      "omegaDegPerMyr": "Rotation rate, degrees per million years (counterclockwise positive)",
      "reference": "Source publication of the pole estimate"
    },
    "validation": [
      "Pacific (PA) pole is 0/0/0, the identity of the Pacific reference frame.",
      "Nazca (NZ) pole 55.578/-90.096/1.3599 and North America (NA) pole 48.709/-78.167/0.7486 match the published NUVEL-1A values (DeMets et al. 1994) verbatim.",
      "Cocos (CO) pole 36.823/-108.629/1.9975 matches NUVEL-1A Cocos-Pacific.",
      "All 52 rows parse with latitudes within +-90, longitudes within +-180, and rates within [0, 60] deg/Myr; no duplicate codes."
    ],
    "note": "Euler vectors are stated with high precision to avoid round-off error in differencing, but accuracy is much less (footnote a of Table 1)."
  },
