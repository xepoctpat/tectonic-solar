{
  "name": "tectonic-solar",
  "version": "1.0.0",
  "private": true,
  "description": "Space-Earth Monitor local deployment simulator with API proxy",
  "main": "server.js",
  "scripts": {
    "launch": "node scripts/launch.js",
    "launch:headless": "node scripts/launch.js --no-open",
    "start": "node server.js",
    "start:sim": "node server.js",
    "build:tectonics": "node scripts/build-pb2002-boundaries.mjs",
    "test:hypothesis-sim": "node scripts/hypothesis-sim.mjs",
    "test:tabs": "node scripts/tab-smoke-test.mjs",
    "test:ux": "node scripts/ux-interaction-test.mjs",
    "test:solar-metrics": "node scripts/solar-metrics-test.mjs",
    "test:seismic-merge": "node scripts/seismic-merge-test.mjs",
    "test:kp-index": "node scripts/kp-index-test.mjs",
    "test:volcanoes": "node scripts/volcanoes-test.mjs",
    "test:volcano-analytics": "node scripts/volcano-analytics-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1"
  },
  "devDependencies": {
    "playwright-core": "^1.58.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
